                           <pdfaProperty:description>XMP08 Spec: An ordered array of plate names that are needed to print the document (including any in contained documents).</pdfaProperty:description>
                           <pdfaProperty:name>PlateNames</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq Text</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>A structure containing the characteristics of a font used in a document</pdfaProperty:description>
                           <pdfaProperty:name>Fonts</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag Font</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structure containing the characteristics of a font used in a document.</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.adobe.com/xap/1.0/sType/Font#</pdfaType:namespaceURI>
